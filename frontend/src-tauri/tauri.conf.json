{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../dist"
  },
  "package": {
    "productName": "LibRE Tab",
    "version": "1.0.0"
  },
  "tauri": {
    "allowlist": {
      "all": true,
      "shell": {
        "all": true,
        "sidecar": true,
        "scope": [
          {
            "name": "binaries/libretab-server",
            "sidecar": true,
            "args": true
          }
        ]
      }
    },
    "bundle": {
      "active": true,
      "category": "Education",
      "copyright": "LibRE Tab Open Source",
      "deb": {
        "depends": []
      },
      "externalBin": [
        "binaries/libretab-server"
      ],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.libretab.app",
      "longDescription": "LibRE Tab - Modular Scientific Statistical Analysis and Reliability Engineering Platform",
      "macOS": {
        "entitlements": null,
        "exceptionDomain": "",
        "frameworks": [],
        "providerShortName": null,
        "signingIdentity": null
      },
      "resources": [],
      "shortDescription": "LibRE Tab Statistical Analysis",
      "targets": "all",
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": ""
      }
    },
    "security": {
      "csp": null
    },
    "updater": {
      "active": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "width": 1280,
        "minHeight": 600,
        "minWidth": 900,
        "center": true,
        "resizable": true,
        "title": "LibRE Tab - Untitled Project"
      }
    ]
  }
}

